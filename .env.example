# Generate a password with: openssl rand -base64 32
OCSTATS_PASSWORD=replace-with-a-long-random-password

# Directory containing opencode.db. Compose does not expand ~, so use an
# absolute path. This is OpenCode's default when XDG_DATA_HOME is not set.
OPENCODE_DATA_DIR=/home/you/.local/share/opencode

# Change this for an OpenCode channel that uses a different database filename.
OPENCODE_DB=opencode.db

# Keep true behind HTTPS. Set false only when opening http://127.0.0.1:4117 directly.
OCSTATS_COOKIE_SECURE=true

# Host port; the container always listens on 4117.
OCSTATS_HTTP_PORT=4117
